DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL blank for local SQLite; Docker Compose uses PostgreSQL.
DATABASE_URL=
# Optional. No API key is needed for deterministic analytics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
